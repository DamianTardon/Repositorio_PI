@startuml
skinparam monochrome true
skinparam componentStyle uml2

package "Capa de Lógica Numérica" {
    [impulse_analyzer.py]
}

package "Capa de Persistencia" {
    [file_manager.py]
}

package "Capa de Reportes" {
    [report.py]
}

package "Entorno de Calibración" {
    [test_cases_data.py]
    [test_impulse_analyzer.py]
}

package "Dependencias Externas" {
    [numpy]
    [scipy]
    [pandas]
    [h5py]
    [fpdf]
    [pytest]
}

' Pruebas unitarias
[test_impulse_analyzer.py] ..> [test_cases_data.py] : Consume
[test_impulse_analyzer.py] ..> [impulse_analyzer.py] : Valida
[test_impulse_analyzer.py] ...> [file_manager.py] : Lee TDG
[test_impulse_analyzer.py] ...> [report.py] : Exporta

' Bibliotecas externas
[impulse_analyzer.py] ..> [numpy]
[impulse_analyzer.py] ..> [scipy]
[file_manager.py] ..> [h5py]
[file_manager.py] ..> [pandas]
[file_manager.py] ..> [numpy]
[report.py] ..> [fpdf]
[test_impulse_analyzer.py] ..> [pytest]

@enduml