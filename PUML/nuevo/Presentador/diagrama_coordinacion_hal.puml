@startuml
skinparam linetype ortho
hide empty members
hide empty description

package "Coordinación" {
  component [Presentador] as Presentador
}

package "Modelo: Abstracción de hardware" {
  component [Controlador de instrumental] as Controlador
  component [Hilo secundario] as PollingThread
  component [Decodificador y desempaquetador] as Decodificador
}

package "Instrumental Físico" {
  component [Osciloscopio GDS-1000A-U] as Osciloscopio
}

Presentador --> Controlador
Presentador --> PollingThread
PollingThread --> Osciloscopio
Osciloscopio ..> PollingThread
PollingThread --> Presentador
Presentador --> Controlador
Controlador --> Osciloscopio
Osciloscopio --> Decodificador
Decodificador --> Presentador

@enduml