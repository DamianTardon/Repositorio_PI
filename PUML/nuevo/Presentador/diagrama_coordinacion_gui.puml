@startuml
skinparam linetype ortho
hide empty members
hide empty description

package "Vista" {
  package "Bloques de captura de datos y configuración" {
    component [Entradas de texto] as ET
    component [Panel de control del osciloscopio] as CO
    component [Panel de opciones de Ensayo] as OE
    component [Controles de visibilidad y escala] as CV
  }

  package "Bloques de salida y visualización" {
    component [Gráficos de ondas] as GO
    component [Tabla de resultados] as TR
  }
}

package "Presentador" {
  component [Receptor de interacciones] as GE
  component [Validador de entrada] as VE
  component [Actualizador reactivo] as AR
  component [Controlador de visualización] as GV
}

' Relaciones de eventos de la Vista al Presentador
ET --> GE
CO --> GE
OE --> GE
CV --> GV

' Flujos de coordinación interna del Presentador
GE --> VE
VE --> AR

' Relaciones de actualización del Presentador a la Vista
AR --> GO
AR --> TR
GV --> GO

@enduml