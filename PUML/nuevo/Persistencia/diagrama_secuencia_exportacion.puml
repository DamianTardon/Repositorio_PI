@startuml
skinparam linetype ortho
hide empty members
hide empty description

actor "Operador" as Operador
participant "Interfaz gráfica" as Vista
participant "Presentador" as Presentador
participant "Gestor de archivos" as FileManager
database "Base de datos" as HDF5
collections "Sistema de ficheros" as Disco
participant "Sistema operativo" as SO

Operador -> Vista : Presionar botón \n"Exportar"
Vista -> Presentador : Solicitar exportación \nde resultados

alt Sesión no creada / Proyecto inactivo
  Presentador -> Vista : Mostrar alerta \n("Crear o abrir \nun ensayo")
  Vista --> Operador : Mensaje de \nadvertencia
else Sesión activa
  Presentador -> FileManager : Solicitar \nrecopilación \nde resultados
  activate FileManager
  FileManager -> HDF5 : Solicitar datos \nde ensayo
  activate HDF5
  HDF5 --> FileManager : Retornar datos \nde ensayo
  deactivate HDF5
  
  FileManager -> FileManager : Escalar unidades \n(V a kV, s a µs)
  FileManager --> Presentador : Entregar tabla \nde resultados
  deactivate FileManager

  alt Sin datos de ensayo almacenados
    Presentador -> Vista : Notificar ausencia \nde registros \nexportables
    Vista --> Operador : Mensaje \ninformativo
  else Datos disponibles para exportar
    Presentador -> Vista : Solicitar ruta, \nnombre y formato
    Vista -> Operador : Mostrar cuadro \nde diálogo de \nguardado de \narchivo
    Operador -> Vista : Seleccionar ubicación \ny formato de salida
    Vista --> Presentador : Retornar ruta de destino \ny formato seleccionado

    Presentador -> FileManager : Convertir y guardar \ntabla en el formato \nespecificado
    activate FileManager
    FileManager -> Disco : Escribir archivo \n.xlsx o .csv
    activate Disco
    Disco --> FileManager : Confirmar escritura
    deactivate Disco
    FileManager --> Presentador : Notificar guardado \nfinalizado
    deactivate FileManager

    Presentador -> SO : Invocar explorador de archivos nativo en la ruta del reporte
    SO --> Operador : Abrir ventana del explorador de archivos con el documento seleccionado
  end
end

@enduml
