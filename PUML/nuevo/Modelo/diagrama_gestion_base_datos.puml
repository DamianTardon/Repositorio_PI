@startuml
skinparam linetype ortho
hide empty members
hide empty description

package "Coordinación" {
  component [Presentador] as Presentador
}

package "Modelo: Persistencia" {
  
  package "Validación y trazabilidad" {
    component [Validar sesión y búfer] as Validador
    component [Generar Trazabilidad] as Trazabilidad
  }

  package "Almacenamiento" {
    component [Manejar archivo HDF5] as HDF5Manager
    component [Organizar grupos y atributos] as StructHDF5
    component [Generar resguardo redundante CSV] as BackupCSV
  }

  package "Exportar resultados" {
    component [Conversor de unidades \n(s -> µs, V -> kV)] as UnitConverter
    component [Generador de Planillas de Resultados] as ExcelExporter
  }
}

package "Sistema de Ficheros" {
  database "Base de datos" as DB_HDF5
  folder "Carpeta de respaldo" as Folder_CSV
  file "Resultados" as File_Excel
}

' Relaciones - Coordinación e Inicio
Presentador --> Validador
Validador --> Trazabilidad
Trazabilidad --> Presentador

' Relaciones - Flujo de Almacenamiento
Presentador --> HDF5Manager
HDF5Manager --> StructHDF5
StructHDF5 --> DB_HDF5

Presentador --> BackupCSV
BackupCSV --> Folder_CSV

' Relaciones - Flujo de Exportación
Presentador --> UnitConverter
UnitConverter --> ExcelExporter
ExcelExporter --> File_Excel

@enduml
