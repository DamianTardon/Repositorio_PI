@startuml
skinparam linetype ortho
hide empty members
hide empty description

package "Referencia patrón (IEC 61083-2)" {
  [TDG] as ArchivosTDG
  [Valores de referencia] as ValoresReferencia
}

package "Módulo de calibración" {
  component [Analizador de resultados] as Colector
}

package "Motor de cálculo" {
  component [Analizador de impulsos] as Analizador
}

package "Cálculo de incertidumbre" {
  component [Verificador de tolerancias] as VerificadorTolerancias
}

package "Emisión de Informe" {
  component [Generador de reportes] as Reportador
  file "Informe_Calibracion_IEC61083_2.pdf" as CertificadoPDF
}

ArchivosTDG --> Analizador

ValoresReferencia --> Colector

Analizador --> Colector

Colector --> VerificadorTolerancias
VerificadorTolerancias --> Colector

Colector --> Reportador
Reportador --> CertificadoPDF

@enduml
